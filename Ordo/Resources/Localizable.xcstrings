    "系统已开启减少动态效果，排布动画暂时停用": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统已开启减少动态效果，排布动画暂时停用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統已開啟減少動態效果，排列動畫暫時停用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout animation is disabled while Reduce Motion is on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視差効果を減らす設定により配置アニメーションは無効です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 줄이기가 켜져 있어 배치 애니메이션이 비활성화됩니다"
          }
        }
      }
    },
    "启用后，松开组合键时窗口平滑移动并调整到目标大小": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，松开组合键时窗口平滑移动并调整到目标大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，放開組合鍵時視窗平滑移動並調整至目標大小"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate the window into place when you release the shortcut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを放すとウインドウが滑らかに移動・サイズ変更します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 놓으면 윈도우가 목표 위치와 크기로 부드럽게 이동합니다"
          }
        }
      }
    },
