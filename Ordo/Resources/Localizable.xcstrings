    "关闭后，Ordo 不再响应窗口手势": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Ordo 不再响应窗口手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，Ordo 不再回應視窗手勢"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Ordo window gestures"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとウインドウのジェスチャが無効になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 Ordo가 윈도우 제스처에 응답하지 않습니다"
          }
        }
      }
    },
    "排布动画": {
      "extractionState": "manual",
