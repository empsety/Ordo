    "登录当前用户后在后台启动 Ordo": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录当前用户后在后台启动 Ordo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入目前使用者後在背景啟動 Ordo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Ordo in the background when you log in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に Ordo をバックグラウンドで起動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 Ordo를 백그라운드에서 실행합니다"
          }
        }
      }
    },
    "隐藏后，可通过 Finder 或 Spotlight 再次打开 Ordo 主窗口": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，可通过 Finder 或 Spotlight 再次打开 Ordo 主窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏後，可透過 Finder 或 Spotlight 再次開啟 Ordo 主視窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Ordo again using Finder or Spotlight when the icon is hidden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした後も Finder や Spotlight から Ordo を開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 숨긴 후에도 Finder 또는 Spotlight에서 Ordo를 열 수 있습니다"
          }
        }
      }
    },
    "启动时不显示主窗口；运行中再次打开 Ordo 仍会显示主窗口": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时不显示主窗口；运行中再次打开 Ordo 仍会显示主窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動時不顯示主視窗；執行中再次開啟 Ordo 仍會顯示主視窗"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the window on launch; opening Ordo again still shows it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動時はウインドウを非表示にします。実行中に Ordo を開くと表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작할 때 창을 숨깁니다. 실행 중인 Ordo를 다시 열면 창이 표시됩니다"
          }
        }
      }
    },
    "开机自启等待批准": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
